# Cabeceras de seguridad · Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://pocketbase-railway-production-6031.up.railway.app https://i.ytimg.com; media-src 'self' blob: https://pocketbase-railway-production-6031.up.railway.app; connect-src 'self' https://pocketbase-railway-production-6031.up.railway.app wss://pocketbase-railway-production-6031.up.railway.app; frame-src https:; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache
